# Reference only; scripts do not load dotenv files. See README for interactive setup.
# Account ID and partition are discovered from STS. Do not put them in this file.
AWS_PROFILE=
AWS_REGION=
PRIMARY_MODEL_ID=
FALLBACK_MODEL_ID=
# setup.py records the generated endpoint in the ignored state file.
# Set this only when using invoke.py with an existing Gateway.
GATEWAY_ENDPOINT=
# If omitted, invoke.py prompts without echoing the token.
GATEWAY_BEARER_TOKEN=
# An array of exact, verified limitKey values; keep real configuration in local/.
# If omitted, no response can trigger application fallback.
FALLBACK_LIMIT_KEYS_FILE=local/limit-keys.json
